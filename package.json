{
  "name": "be-donation-app",
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "tsup && node dist/index.cjs",
    "start:prod": "./node_modules/.bin/env-cmd -f .env.prod tsc && node --trace-warnings dist/api/index.js",
    "lint": "eslint 'src/**/*.ts'",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:generate-prod": "env-cmd -f .env.prod npx drizzle-kit generate --config=drizzle-prod.config.ts",
    "db:migrate-prod": "env-cmd -f .env.prod npx drizzle-kit migrate --config=drizzle-prod.config.ts"
  },
  "keywords": [],
