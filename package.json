    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "env-cmd": "^10.1.0",
    "hono": "^4.7.10",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.1",
    "node-telegram-bot-api": "^0.66.0",
    "tsup": "^8.5.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  }
